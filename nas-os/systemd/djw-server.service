[Unit]
Description=DJW Main Unit server
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/djw-nas/app
ExecStart=/usr/bin/python3 /opt/djw-nas/app/server.py
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
