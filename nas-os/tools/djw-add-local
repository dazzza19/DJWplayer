#!/bin/bash
set -euo pipefail
read -r -p 'Mounted directory to add (for example /media/usb/Movies): ' dir
[[ -d "$dir" ]] || { echo 'Directory does not exist.' >&2; exit 1; }
read -r -p 'Library category [Film/TV/Music]: ' kind
case "$kind" in Film|TV|Music) ;; *) echo 'Use Film, TV, or Music.' >&2; exit 1;; esac
python3 - "$dir" "$kind" <<'PY'
import json,sys,pathlib
p=pathlib.Path('/etc/djw-nas/server.json'); c=json.loads(p.read_text())
path=str(pathlib.Path(sys.argv[1]).resolve()); name=pathlib.Path(path).name
c['sources'].append({'id':'local-'+str(len(c['sources'])+1),'name':name,'kind':sys.argv[2],'path':path})
p.write_text(json.dumps(c,indent=2)+'\n')
PY
systemctl restart djw-server.service
