#!/bin/bash
set -euo pipefail
read -r -p 'Share address (//server/share): ' remote
[[ "$remote" == //*/* ]] || { echo 'Expected //server/share.' >&2; exit 1; }
read -r -p 'Mount name (letters, numbers, dash): ' name
[[ "$name" =~ ^[A-Za-z0-9-]+$ ]] || { echo 'Invalid mount name.' >&2; exit 1; }
read -r -p 'Username: ' user
read -r -s -p 'Password: ' pass; echo
read -r -p 'Library category [Film/TV/Music]: ' kind
case "$kind" in Film|TV|Music) ;; *) echo 'Use Film, TV, or Music.' >&2; exit 1;; esac
cred="/etc/djw-nas/smb-creds/$name"
printf 'username=%s\npassword=%s\n' "$user" "$pass" > "$cred"; chmod 0600 "$cred"; unset pass
mountpoint="/mnt/djw/shares/$name"; install -d -m 0755 "$mountpoint"
grep -Fq "$remote" /etc/fstab || printf '%s %s cifs credentials=%s,vers=3.0,iocharset=utf8,uid=1000,gid=1000,ro,nofail,x-systemd.automount 0 0\n' "$remote" "$mountpoint" "$cred" >> /etc/fstab
systemctl daemon-reload; systemctl start "$(systemd-escape --path --suffix=automount "$mountpoint")" || true
python3 - "$mountpoint" "$kind" "$name" <<'PY'
import json,sys,pathlib
p=pathlib.Path('/etc/djw-nas/server.json'); c=json.loads(p.read_text()); c['sources'].append({'id':'smb-'+sys.argv[3],'name':sys.argv[3],'kind':sys.argv[2],'path':sys.argv[1]}); p.write_text(json.dumps(c,indent=2)+'\n')
PY
systemctl restart djw-server.service
